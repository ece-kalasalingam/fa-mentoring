{
  "name": "fa-mentoring-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-08",
  "account_id": "ebae5f2a315736349f026474e57089dc",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "spris-api.eceklu.in",
      "zone_name": "eceklu.in",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "vars": {
    "AUTH_PROVIDER": "password-session",
    "ALLOW_INSECURE_AUTH_NONE": "false",
    "FRONTEND_ORIGIN": "https://spris.eceklu.in",
    "LOG_DISABLE_SUCCESS_REQUESTS": "true",
    "LOG_INFO_SAMPLE_RATE": "0.05",
    "LOG_PRUNE_EVERY_N_WRITES": "200",
    "LOG_RETENTION_DAYS": "7",
    "LOG_MAX_ROWS": "500"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "limits": {
    "subrequests": 1000
  }
}
